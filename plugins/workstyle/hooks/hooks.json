{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v jq >/dev/null || echo 'workstyle: jq is not installed, so its PreToolUse guards block every Bash/Edit/Write call. Install jq.' >&2; f=\"$CLAUDE_PLUGIN_DATA/learnings.md\"; if [ -f \"$f\" ]; then n=$(grep -c '^- tag:' \"$f\"); echo \"workstyle plugin: $n learnings captured — /workstyle:review-learnings to promote any.\"; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/type-safety-guard.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/protected-file-guard.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/git-add-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^workstyle:(backend|frontend)-builder$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gates.sh\" --hook",
            "timeout": 1800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gates.sh\" --hook",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
